'Spaceship - zen mode
'
'No enemies, no damage, no score: the ship drifts through a deep starfield while
'scenery floats by. The map is many screens tall and split into areas (data/zen.txt),
'each with its own looping scenery. Up and down scroll the view while the ship stays
'centered; only at the top or bottom of the map does the ship move off the center. Right speeds up,
'left slows down. Stars sit on three depth layers and scenery has its own depth, so
'everything slides at its own pace (parallax).
'
'Scenery positions: an object's Y is where it appears on screen when the view is at
'CamY = 0. With the view at CamY it shows at Y - CamY * depth, so far things barely
'move as you climb and near things slide past quickly.

SUB LoadZenScenes (f AS STRING)
    DIM fh AS LONG, l AS STRING, a AS INTEGER
    ZenSceneCount = 0
    ZenAreaCount = 0
    IF _FILEEXISTS(f) = 0 THEN LogMsg "Missing zen scenery: " + f: EXIT SUB
    fh = FREEFILE
    OPEN f FOR INPUT AS #fh
    DO UNTIL EOF(fh)
        LINE INPUT #fh, l
        l = _TRIM$(l)
        IF LEN(l) = 0 OR LEFT$(l, 1) = ";" THEN _CONTINUE
        SELECT CASE UCASE$(Word$(l, 1))
            CASE "AREA"
                IF ZenAreaCount < MAX_ZEN_AREAS THEN
                    ZenAreaCount = ZenAreaCount + 1
                    a = ZenAreaCount
                    ZenAreas(a).CamFrom = VAL(Word$(l, 2))
                    ZenAreas(a).CamTo = VAL(Word$(l, 3))
                    ZenAreas(a).Nm = UCASE$(Rest$(l, 4))
                    ZenAreas(a).FirstScene = ZenSceneCount + 1
                    ZenAreas(a).LastScene = ZenSceneCount
                END IF
            CASE "SCENE"
                IF ZenAreaCount = 0 THEN
                    'Scenes before any AREA line get a one-screen area of their own
                    ZenAreaCount = 1
                    ZenAreas(1).CamFrom = -12
                    ZenAreas(1).CamTo = 12
                    ZenAreas(1).Nm = ""
                    ZenAreas(1).FirstScene = 1
                    ZenAreas(1).LastScene = 0
                END IF
                IF ZenSceneCount < MAX_ZEN_SCENES THEN
                    IF SpriteID%(Word$(l, 3)) = 0 THEN
                        LogMsg "Unknown zen sprite: " + Word$(l, 3)
                    ELSE
                        ZenSceneCount = ZenSceneCount + 1
                        ZenScenes(ZenSceneCount).Gap = VAL(Word$(l, 2))
                        ZenScenes(ZenSceneCount).Sprite = SpriteID%(Word$(l, 3))
                        ZenScenes(ZenSceneCount).Depth = VAL(Word$(l, 4))
                        ZenScenes(ZenSceneCount).Clr = VAL(Word$(l, 5))
                        ZenScenes(ZenSceneCount).Row = VAL(Word$(l, 6))
                        ZenAreas(ZenAreaCount).LastScene = ZenSceneCount
                    END IF
                END IF
        END SELECT
    LOOP
    CLOSE #fh
END SUB

SUB StartZen
    DIM i AS INTEGER, k AS INTEGER
    ClearEnemies
    ClearBullets
    ClearFX
    FOR i = 1 TO MAX_PK
        Pk(i).Active = 0
    NEXT
    FOR i = 1 TO MAX_ZEN_OBJS
        ZenObjs(i).Active = 0
    NEXT
    FOR i = 1 TO MAX_ZEN_STARS
        NewZenStar i, 0
    NEXT
    'The map spans all the areas; the view starts at 0
    Zen.MapTop = 0
    Zen.MapBot = 0
    FOR i = 1 TO ZenAreaCount
        IF ZenAreas(i).CamFrom < Zen.MapTop THEN Zen.MapTop = ZenAreas(i).CamFrom
        IF ZenAreas(i).CamTo > Zen.MapBot THEN Zen.MapBot = ZenAreas(i).CamTo
        ZenAreas(i).Scene = ZenAreas(i).FirstScene - 1
        ZenAreas(i).NextAt = RND * 4
    NEXT
    Zen.CamY = 0
    Zen.Speed = 1
    Zen.Dist = 0
    Zen.DCam = 0
    Zen.DShip = 0
    'Let the world run for a minute so every area already has scenery in flight
    FOR k = 1 TO 600
        UpdateZenWorld .1
    NEXT
    Zen.Area = ZenAreaAt%(Zen.CamY)
    Zen.AreaT = -100
    Zen.VMoveT = -100
    Zen.LastReal = RealNow#
    'The ship glides in from the left edge
    Ply.X = 1
    Ply.Y = 25
    Ply.Size = 2
    Ply.Alive = -1
    Ply.Dying = 0
    Ply.Shield = 0
    Ply.Freeze = 0
    Ply.Recharge = 0
    Ply.ExitPhase = 3 'draws the engine flame
    Ply.ExitV = 0
    Game.T = 0
    Ply.LastDamage = -100
    Ply.LastGrow = -100
    Ply.SmokeT = -100
    Ply.MuzzleT = -100
    Ply.PrevX = 1
    GoState ST_ZEN
    PlaySong SONG_ZEN
END SUB

SUB NewZenStar (i AS INTEGER, atEdge AS _BYTE)
    DIM r AS SINGLE
    IF atEdge THEN ZenStars(i).X = 81 + RND * 4 ELSE ZenStars(i).X = 1 + RND * 80
    ZenStars(i).Y = 1 + RND * 25
    r = RND
    IF r < .45 THEN
        ZenStars(i).Layer = 1
    ELSEIF r < .8 THEN
        ZenStars(i).Layer = 2
    ELSE
        ZenStars(i).Layer = 3
    END IF
    SELECT CASE ZenStars(i).Layer
        CASE 1: ZenStars(i).Clr = 8: ZenStars(i).Ch = CHR$(250)
        CASE 2: ZenStars(i).Clr = 8: ZenStars(i).Ch = CHR$(249)
        CASE 3: ZenStars(i).Clr = 7: ZenStars(i).Ch = CHR$(249)
    END SELECT
    'A few tinted stars
    IF ZenStars(i).Layer > 1 AND RND < .12 THEN
        SELECT CASE INT(RND * 4)
            CASE 0: ZenStars(i).Clr = 9
            CASE 1: ZenStars(i).Clr = 11
            CASE 2: ZenStars(i).Clr = 14
            CASE ELSE: ZenStars(i).Clr = 13
        END SELECT
    END IF
END SUB

SUB ZenFrame
    DIM now AS DOUBLE, dt AS SINGLE, age AS DOUBLE, a AS INTEGER
    IF MenuBack% OR InPressed(A_START) THEN
        Ply.ExitPhase = 0
        GoTitle
        EXIT SUB
    END IF
    now = RealNow#
    dt = now - Zen.LastReal
    Zen.LastReal = now
    IF dt > .05 THEN dt = .05
    IF dt < 0 THEN dt = 0
    Game.T = Game.T + dt
    age = UINow# - Game.StateT

    UpdateZenShip dt, age
    UpdateZenWorld dt
    'Flying into a new area shows its name
    a = ZenAreaAt%(Zen.CamY)
    IF a <> Zen.Area THEN
        Zen.Area = a
        IF a > 0 THEN Zen.AreaT = Game.T
    END IF
    RenderZen age
END SUB

'Which area the view is in (0 if none)
FUNCTION ZenAreaAt% (cam AS SINGLE)
    DIM i AS INTEGER
    ZenAreaAt% = 0
    FOR i = 1 TO ZenAreaCount
        IF cam >= ZenAreas(i).CamFrom AND cam <= ZenAreas(i).CamTo THEN ZenAreaAt% = i: EXIT FUNCTION
    NEXT
END FUNCTION

SUB UpdateZenShip (dt AS SINGLE, age AS DOUBLE)
    DIM sp AS SINGLE, target AS SINGLE, prevY AS SINGLE, camBefore AS SINGLE
    camBefore = Zen.CamY
    prevY = Ply.Y
    IF age < 1.2 THEN
        'Glide in, no control yet
        Ply.X = Ply.X + (14 - Ply.X) * (dt * 3)
    ELSE
        sp = 24 * dt
        'The ship stays centered and the view scrolls. Only at the top or bottom of
        'the map, where the view can't scroll further, does the ship leave the center;
        'heading back, it returns to the center before the view moves again.
        IF InHeld(A_UP) THEN
            IF Ply.Y > ZEN_CENTER THEN
                Ply.Y = Ply.Y - sp
                IF Ply.Y < ZEN_CENTER THEN Ply.Y = ZEN_CENTER
            ELSEIF Zen.CamY > Zen.MapTop THEN
                Zen.CamY = Zen.CamY - sp / 2
                IF Zen.CamY < Zen.MapTop THEN Zen.CamY = Zen.MapTop
            ELSE
                Ply.Y = Ply.Y - sp
            END IF
        END IF
        IF InHeld(A_DOWN) THEN
            IF Ply.Y < ZEN_CENTER THEN
                Ply.Y = Ply.Y + sp
                IF Ply.Y > ZEN_CENTER THEN Ply.Y = ZEN_CENTER
            ELSEIF Zen.CamY < Zen.MapBot THEN
                Zen.CamY = Zen.CamY + sp / 2
                IF Zen.CamY > Zen.MapBot THEN Zen.CamY = Zen.MapBot
            ELSE
                Ply.Y = Ply.Y + sp
            END IF
        END IF
        IF Ply.Y < UpperLimit% THEN Ply.Y = UpperLimit%
        IF Ply.Y > LowerLimit% THEN Ply.Y = LowerLimit%
        'Left and right: drift on screen and change cruising speed
        IF InHeld(A_RIGHT) AND Ply.X < 50 THEN Ply.X = Ply.X + sp / 2
        IF InHeld(A_LEFT) AND Ply.X > 8 THEN Ply.X = Ply.X - sp / 2
    END IF
    target = 1
    IF InHeld(A_RIGHT) THEN target = 3
    IF InHeld(A_LEFT) THEN target = .3
    Zen.Speed = Zen.Speed + (target - Zen.Speed) * Clamp!(dt * 1.2, 0, 1)
    Ply.ExitV = (Zen.Speed - .6) * 15
    IF Ply.ExitV < 0 THEN Ply.ExitV = 0
    IF INT(Ply.X) > Ply.PrevX THEN Ply.SmokeT = Game.T
    Ply.PrevX = INT(Ply.X)
    'How far the view and the ship moved this frame, in rows (for the star parallax)
    Zen.DCam = Zen.CamY - camBefore
    Zen.DShip = (Ply.Y - prevY) / 2
    IF Zen.DCam <> 0 THEN Zen.VMoveT = Game.T
END SUB

SUB UpdateZenWorld (dt AS SINGLE)
    DIM i AS INTEGER, k AS INTEGER, a AS INTEGER, sc AS INTEGER, vy AS SINGLE, cam AS SINGLE
    'Stars: nearer layers scroll faster and slide more when the view moves
    FOR i = 1 TO MAX_ZEN_STARS
        k = ZenStars(i).Layer
        ZenStars(i).X = ZenStars(i).X - ZenLayerSpeed!(k) * Zen.Speed * dt
        vy = Zen.DCam * ZenLayerDepth!(k) + Zen.DShip * .15 * k
        ZenStars(i).Y = ZenStars(i).Y - vy
        IF ZenStars(i).Y < 1 THEN ZenStars(i).Y = ZenStars(i).Y + 25
        IF ZenStars(i).Y >= 26 THEN ZenStars(i).Y = ZenStars(i).Y - 25
        IF ZenStars(i).X < 0 THEN NewZenStar i, -1
        'Twinkle
        IF k = 3 AND RND < .002 THEN
            SELECT CASE ZenStars(i).Clr
                CASE 7: ZenStars(i).Clr = 15
                CASE 15: ZenStars(i).Clr = 7
            END SELECT
        END IF
    NEXT
    Zen.DCam = 0
    Zen.DShip = 0
    'Scenery drifts left at its own depth; its place on the map stays put
    FOR i = 1 TO MAX_ZEN_OBJS
        IF ZenObjs(i).Active THEN
            ZenObjs(i).X = ZenObjs(i).X - Zen.Speed * ZenObjs(i).Depth * 22 * dt
            IF ZenObjs(i).X + Sprites(ZenObjs(i).Sprite).W < 0 THEN ZenObjs(i).Active = 0
        END IF
    NEXT
    'Every area runs its own scenery loop, on screen or not
    Zen.Dist = Zen.Dist + Zen.Speed * dt
    FOR a = 1 TO ZenAreaCount
        IF ZenAreas(a).LastScene >= ZenAreas(a).FirstScene THEN
            IF Zen.Dist >= ZenAreas(a).NextAt THEN
                ZenAreas(a).Scene = ZenAreas(a).Scene + 1
                IF ZenAreas(a).Scene > ZenAreas(a).LastScene THEN ZenAreas(a).Scene = ZenAreas(a).FirstScene
                sc = ZenAreas(a).Scene
                'Somewhere in the area: the scene's row is where it shows with the view there
                cam = ZenAreas(a).CamFrom + RND * (ZenAreas(a).CamTo - ZenAreas(a).CamFrom)
                SpawnZenObj sc, ZenScenes(sc).Row + cam * ZenScenes(sc).Depth
                IF sc < ZenAreas(a).LastScene THEN sc = sc + 1 ELSE sc = ZenAreas(a).FirstScene
                ZenAreas(a).NextAt = Zen.Dist + ZenScenes(sc).Gap
            END IF
        END IF
    NEXT
END SUB

SUB SpawnZenObj (sc AS INTEGER, mapY AS SINGLE)
    DIM i AS INTEGER
    FOR i = 1 TO MAX_ZEN_OBJS
        IF ZenObjs(i).Active = 0 THEN
            ZenObjs(i).Active = -1
            ZenObjs(i).Sprite = ZenScenes(sc).Sprite
            ZenObjs(i).X = 81
            ZenObjs(i).Y = mapY
            ZenObjs(i).Depth = ZenScenes(sc).Depth
            ZenObjs(i).Clr = ZenScenes(sc).Clr
            EXIT SUB
        END IF
    NEXT
END SUB

FUNCTION ZenLayerSpeed! (k AS INTEGER)
    SELECT CASE k
        CASE 1: ZenLayerSpeed! = 2.5
        CASE 2: ZenLayerSpeed! = 6
        CASE ELSE: ZenLayerSpeed! = 13
    END SELECT
END FUNCTION

FUNCTION ZenLayerDepth! (k AS INTEGER)
    SELECT CASE k
        CASE 1: ZenLayerDepth! = .3
        CASE 2: ZenLayerDepth! = .6
        CASE ELSE: ZenLayerDepth! = 1
    END SELECT
END FUNCTION

SUB RenderZen (age AS DOUBLE)
    DIM t AS SINGLE
    CLS , 0
    COLOR , 0
    _PALETTECOLOR 0, _RGBA32(0, 0, 0, 0)
    'Back to front: far scenery, far stars, near scenery, near stars, ship
    DrawZenObjs 0, .3
    DrawZenStars 1
    DrawZenStars 2
    DrawZenObjs .3, 2
    DrawZenStars 3
    DrawPlayer

    'Title, then the name of each new area as you fly into it
    IF age < 6 THEN
        COLOR FadeColor%(age, 6)
        CenterText 11, "Z  E  N"
    ELSE
        t = Game.T - Zen.AreaT
        IF t < 5 AND Zen.Area > 0 THEN
            COLOR FadeColor%(t, 5)
            CenterText 11, SpacedOut$(RTRIM$(ZenAreas(Zen.Area).Nm))
        END IF
    END IF
    IF age < 9 THEN
        COLOR 8
        CenterText 25, "ARROWS: DRIFT, CLIMB AND DIVE    ESC: MENU"
    END IF
    'Altitude gauge on the right edge while climbing or diving
    IF Game.T - Zen.VMoveT < 2.5 THEN DrawZenGauge
    IF Game.Mute THEN COLOR 0, 7: PutText 75, 1, " MUTE ": COLOR , 0
END SUB

'Dim, bright, then dim again over a message's lifetime
FUNCTION FadeColor% (t AS SINGLE, life AS SINGLE)
    IF t < .6 OR t > life - .6 THEN
        FadeColor% = 8
    ELSEIF t < 1.2 OR t > life - 1.4 THEN
        FadeColor% = 7
    ELSE
        FadeColor% = 15
    END IF
END FUNCTION

FUNCTION SpacedOut$ (s AS STRING)
    DIM i AS INTEGER, r AS STRING
    FOR i = 1 TO LEN(s)
        r = r + MID$(s, i, 1)
        IF i < LEN(s) THEN r = r + " "
    NEXT
    SpacedOut$ = r
END FUNCTION

SUB DrawZenGauge
    DIM r AS INTEGER, mark AS INTEGER, span AS SINGLE
    span = Zen.MapBot - Zen.MapTop
    IF span <= 0 THEN EXIT SUB
    COLOR 8
    FOR r = 4 TO 22
        _PRINTSTRING (80, r), CHR$(179)
    NEXT
    mark = 4 + INT((Zen.CamY - Zen.MapTop) / span * 18 + .5)
    COLOR 15
    _PRINTSTRING (80, mark), CHR$(254)
END SUB

SUB DrawZenStars (layer AS INTEGER)
    DIM i AS INTEGER, ch AS STRING
    FOR i = 1 TO MAX_ZEN_STARS
        IF ZenStars(i).Layer = layer THEN
            IF ZenStars(i).X >= 1 AND ZenStars(i).X < 81 THEN
                ch = ZenStars(i).Ch
                IF Zen.Speed > 2.4 AND layer = 3 THEN ch = CHR$(196)
                COLOR ZenStars(i).Clr
                _PRINTSTRING (INT(ZenStars(i).X), INT(ZenStars(i).Y)), ch
            END IF
        END IF
    NEXT
END SUB

'Draws the on-screen scenery whose depth is in [d0, d1), farthest first
SUB DrawZenObjs (d0 AS SINGLE, d1 AS SINGLE)
    DIM i AS INTEGER, j AS INTEGER, n AS INTEGER, t AS INTEGER, sy AS INTEGER
    DIM order(1 TO MAX_ZEN_OBJS) AS INTEGER
    FOR i = 1 TO MAX_ZEN_OBJS
        IF ZenObjs(i).Active AND ZenObjs(i).Depth >= d0 AND ZenObjs(i).Depth < d1 THEN
            IF ZenObjs(i).X < 81 THEN
                sy = INT(ZenObjs(i).Y - Zen.CamY * ZenObjs(i).Depth)
                IF sy <= 25 AND sy + Sprites(ZenObjs(i).Sprite).H > PLAY_TOP THEN
                    n = n + 1
                    order(n) = i
                END IF
            END IF
        END IF
    NEXT
    FOR i = 2 TO n
        j = i
        DO WHILE j > 1
            IF ZenObjs(order(j)).Depth >= ZenObjs(order(j - 1)).Depth THEN EXIT DO
            t = order(j): order(j) = order(j - 1): order(j - 1) = t
            j = j - 1
        LOOP
    NEXT
    FOR i = 1 TO n
        sy = INT(ZenObjs(order(i)).Y - Zen.CamY * ZenObjs(order(i)).Depth)
        DrawSprite ZenObjs(order(i)).Sprite, 1, INT(ZenObjs(order(i)).X), sy, ZenObjs(order(i)).Clr, 0
    NEXT
END SUB
