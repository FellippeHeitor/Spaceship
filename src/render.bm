'Spaceship - images, HUD and frame composition

SUB CreateImages
    DIM canvas AS LONG, c AS INTEGER, i AS INTEGER

    'Smoke puffs drawn behind the ship when it moves forward
    canvas = _NEWIMAGE(3 * _FONTWIDTH, _FONTHEIGHT, 32)
    _DEST canvas
    COLOR _RGB32(89, 89, 89), _RGBA32(0, 0, 0, 0)
    _PRINTSTRING (0, 0), CHR$(176) + CHR$(177)
    COLOR _RGB32(144, 144, 144), _RGBA32(0, 0, 0, 0)
    _PRINTSTRING (0, 0), CHR$(32) + CHR$(32) + CHR$(178)
    SmokeImages(3) = _COPYIMAGE(canvas, 33)
    CLS
    COLOR _RGB32(89, 89, 89), _RGBA32(0, 0, 0, 0)
    _PRINTSTRING (0, 0), CHR$(32) + CHR$(177) + CHR$(178)
    COLOR _RGB32(144, 144, 144), _RGBA32(0, 0, 0, 0)
    _PRINTSTRING (0, 0), CHR$(32) + CHR$(32) + CHR$(178)
    SmokeImages(2) = _COPYIMAGE(canvas, 33)
    CLS
    COLOR _RGB32(89, 89, 89), _RGBA32(0, 0, 0, 0)
    _PRINTSTRING (0, 0), CHR$(32) + CHR$(32) + CHR$(178)
    COLOR _RGB32(144, 144, 144), _RGBA32(0, 0, 0, 0)
    _PRINTSTRING (0, 0), CHR$(32) + CHR$(32) + CHR$(178)
    SmokeImages(1) = _COPYIMAGE(canvas, 33)
    _DEST 0
    _FREEIMAGE canvas

    'Shield bubbles
    canvas = _NEWIMAGE(7 * _FONTWIDTH, 4 * _FONTHEIGHT, 32)
    _DEST canvas
    FOR c = 1 TO 10
        CLS , _RGBA32(0, 0, 0, 0)
        COLOR _RGBA32(RND * 200 + 50, RND * 200 + 50, RND * 200 + 50, 25.5 * c), _RGBA32(0, 0, 0, 0)
        FOR i = 1 TO 4
            _PRINTSTRING (0, _FONTHEIGHT * i - _FONTHEIGHT), STRING$(7, 176)
        NEXT i
        ShieldImages(c) = _COPYIMAGE(canvas, 33)
    NEXT c
    _DEST 0
    _FREEIMAGE canvas

    'Progress bar (kills / time) and boss health bar
    canvas = _NEWIMAGE(80 * _FONTWIDTH, _FONTHEIGHT, 32)
    _DEST canvas
    CLS , _RGBA32(0, 0, 0, 0)
    FOR i = 1 TO 80
        COLOR _RGBA32(255, 0, 0, (150 * (i / 80)) + 105), _RGBA32(0, 0, 0, 0)
        _PRINTSTRING (i * _FONTWIDTH - _FONTWIDTH, 0), CHR$(219)
    NEXT
    LifeBarImage = _COPYIMAGE(canvas, 33)
    CLS , _RGBA32(0, 0, 0, 0)
    FOR i = 1 TO 80
        COLOR _RGBA32(200 - i, 60 + i, 255, (120 * (i / 80)) + 135), _RGBA32(0, 0, 0, 0)
        _PRINTSTRING (i * _FONTWIDTH - _FONTWIDTH, 0), CHR$(219)
    NEXT
    BossBarImage = _COPYIMAGE(canvas, 33)
    _DEST 0
    _FREEIMAGE canvas
END SUB

FUNCTION RestoreImage& (PixelColor AS _UNSIGNED LONG)
    'Call after RESTORE points at an image DATA block
    DIM w AS INTEGER, h AS INTEGER, a AS LONG, prevDest AS LONG
    DIM ih AS INTEGER, iw AS INTEGER, b AS STRING, c AS INTEGER, p AS INTEGER
    READ w
    READ h
    a = _NEWIMAGE(w, h, 32)
    prevDest = _DEST
    _DEST a
    ih = 0: iw = 0
    DO
        READ b
        IF b = "*" THEN
            ih = ih + 1
            iw = 0
            IF ih = h THEN EXIT DO
            _CONTINUE
        END IF
        c = VAL(LEFT$(b, LEN(b) - 1))
        IF RIGHT$(b, 1) = "W" THEN
            FOR p = iw TO iw + c - 1
                PSET (p, ih), PixelColor
            NEXT
        END IF
        iw = iw + c
    LOOP
    RestoreImage& = _COPYIMAGE(a, 33)
    _FREEIMAGE a
    _DEST prevDest
END FUNCTION

SUB DrawLogo (y AS INTEGER, fade AS INTEGER)
    DIM f AS INTEGER
    f = fade
    IF f < 1 THEN f = 1
    IF f > 16 THEN f = 16
    IF LogoImages(f) < -1 THEN
        _PUTIMAGE (((80 * _FONTWIDTH) \ 2) - (_WIDTH(LogoImages(f)) \ 2), y), LogoImages(f), 0
    END IF
END SUB

SUB SetFlash (r AS INTEGER, g AS INTEGER, b AS INTEGER, secs AS SINGLE)
    Game.FlashClr = _RGB32(r, g, b)
    Game.FlashUntil = Game.T + secs
END SUB

SUB ShowMessage (s AS STRING, clr AS INTEGER, secs AS SINGLE)
    Game.MsgText = s
    Game.MsgClr = clr
    Game.MsgUntil = Game.T + secs
END SUB

'Message box centered on the screen: fg on bg
SUB Banner (y AS INTEGER, s AS STRING, fg AS INTEGER, bg AS INTEGER)
    COLOR fg, bg
    CenterText y, s
    COLOR , 0
END SUB

SUB RenderPlay
    CLS , 0
    COLOR , 0
    IF Game.T < Game.FlashUntil THEN
        _PALETTECOLOR 0, Game.FlashClr
    ELSE
        _PALETTECOLOR 0, _RGBA32(0, 0, 0, 0)
    END IF

    DrawBackdrop
    DrawStars
    DrawTerrain
    DrawPickups
    DrawEnemies
    DrawBullets
    DrawPlayer
    DrawFX
    DrawHUD
    DrawOverlays
END SUB

SUB DrawHUD
    DIM e AS STRING, i AS INTEGER, energyClr AS INTEGER, s AS STRING, x AS INTEGER
    DIM fr AS SINGLE, w AS INTEGER
    STATIC warnToggle AS _BYTE, warnT AS DOUBLE, blink AS _BYTE

    COLOR 15, 1
    PutText 1, 1, SPACE$(80)
    COLOR 14
    PutText 2, 1, CHR$(220) + CHR$(223) + CHR$(220)
    COLOR 15
    IF Ply.Lives >= 0 THEN PutText 6, 1, "x" + NumStr$(Ply.Lives) ELSE PutText 6, 1, "x0"
    PutText 10, 1, PadNum$(Ply.Score, 7)
    IF Game.Mute THEN COLOR 0, 7: PutText 18, 1, " MUTE ": COLOR 15, 1

    IF Ply.Combo >= 3 THEN
        COLOR 14
        PutText 25, 1, "x" + NumStr$(ComboMult%) + " COMBO"
    END IF

    'Weapon level
    COLOR 7
    PutText 49, 1, "GUN"
    FOR i = 1 TO 4
        IF i <= Ply.Weapon THEN COLOR 12 ELSE COLOR 8
        PutText 52 + i, 1, CHR$(254)
    NEXT

    'Specials: F(reeze) B(omb) M(issiles) O(verdrive)
    x = 58
    FOR i = 1 TO SP_COUNT
        s = LEFT$(SpecialName(i), 1) + NumStr$(SpecialCount(i))
        IF i = Ply.CurSpecial THEN
            COLOR 0, 7
        ELSE
            COLOR 15, 1
            IF SpecialCount(i) = 0 THEN COLOR 8
        END IF
        PutText x, 1, s
        COLOR 15, 1
        x = x + 3
    NEXT

    'Energy
    IF Ply.Energy > 100 THEN Ply.Energy = 100
    e = STRING$(INT(Ply.Energy / 10), 254)
    e = e + STRING$(10 - LEN(e), 249)
    SELECT CASE Ply.Energy
        CASE IS <= 10: energyClr = 28
        CASE IS <= 30: energyClr = 12
        CASE IS <= 60: energyClr = 14
        CASE ELSE: energyClr = 10
    END SELECT
    IF Game.T - Ply.LastEnergyUp <= .2 THEN
        blink = NOT blink
        IF blink THEN energyClr = 9 ELSE energyClr = 10
    END IF
    COLOR energyClr, 1
    PutText 70, 1, e

    'Center of the top bar: status messages
    IF Ply.Energy <= 10 AND Ply.Alive AND NOT Ply.Recharge AND NOT Ply.Dying THEN
        IF Game.T - warnT > 1 THEN warnT = Game.T: warnToggle = NOT warnToggle
        IF Ply.Energy < ShotCost! THEN
            s = " GUNS RECHARGING "
        ELSEIF warnToggle THEN
            s = "   LOW ENERGY    "
        ELSE
            s = "  EASE OFF FIRE  "
        END IF
        Banner 1, s, 15, 4
    END IF
    IF Game.T - Ply.ShieldT < 1 AND Ply.Shield THEN Banner 1, " SHIELD ENGAGED ", 0, 7
    'Top-bar messages (gun level, shield, overdrive...) go over the HUD
    IF Game.T < Game.TopMsgUntil THEN Banner 1, RTRIM$(Game.TopMsg), 0, 7

    'Bottom bar: chapter progress or boss health
    COLOR , 0
    IF BossActive% THEN
        fr = BossHPFraction!
        w = INT(fr * 80 * _FONTWIDTH)
        IF w > 0 THEN _PUTIMAGE (0, 24 * _FONTHEIGHT), BossBarImage, 0, (0, 0)-STEP(w, _FONTHEIGHT)
        COLOR 15
        PutText 2, 25, RTRIM$(Game.BossTitle)
    ELSEIF Lvl.Started AND NOT Lvl.GoalDone THEN
        fr = Clamp!(Lvl.Progress, 0, 1)
        w = INT(fr * 80 * _FONTWIDTH)
        IF w > 0 THEN _PUTIMAGE (0, 24 * _FONTHEIGHT), LifeBarImage, 0, (0, 0)-STEP(w, _FONTHEIGHT)
        IF Lvl.GoalType = GOAL_SURVIVE OR Lvl.GoalType = GOAL_DISTANCE THEN
            COLOR 8
            PutText 2, 25, NumStr$(INT(Lvl.GoalN - Lvl.T + .99)) + "s"
        ELSEIF Lvl.GoalType = GOAL_COLLECT THEN
            COLOR 8
            PutText 2, 25, NumStr$(Lvl.Collected) + "/" + NumStr$(Lvl.GoalN)
        END IF
    END IF
    COLOR , 0
END SUB

SUB DrawOverlays
    DIM s AS STRING, p AS INTEGER, remain AS DOUBLE, i AS INTEGER, who AS STRING, l1 AS STRING, l2 AS STRING
    DIM n AS INTEGER

    'Chapter name
    IF Game.T - Lvl.ShowNameT < 2.5 AND NOT Ply.Dying THEN
        IF Lvl.Bonus THEN
            s = " BONUS STAGE "
        ELSE
            s = " CHAPTER " + NumStr$(Lvl.ChapterNo) + " "
        END IF
        Banner 11, s, 15, 1
        s = RTRIM$(Lvl.Nm)
        p = INSTR(s, "|")
        IF p = 0 THEN
            Banner 12, " " + s + " ", 15, 1
        ELSE
            Banner 12, " " + LEFT$(s, p - 1) + " ", 15, 1
            Banner 13, " " + MID$(s, p + 1) + " ", 15, 1
        END IF
    END IF

    'Radio chatter (bottom left)
    IF Game.T < Game.TipUntil AND LEN(RTRIM$(Game.TipText)) THEN
        s = RTRIM$(Game.TipText)
        p = INSTR(s, ":")
        who = LEFT$(s, p)
        s = MID$(s, p + 1)
        p = INSTR(s, "|")
        IF p THEN l1 = LEFT$(s, p - 1): l2 = MID$(s, p + 1) ELSE l1 = s: l2 = ""
        COLOR 15, 1
        PutText 1, 22, " " + who + " "
        PutText 1, 23, " " + l1 + " "
        IF LEN(l2) THEN PutText 1, 24, " " + l2 + " "
        COLOR , 0
    END IF

    'Boss warning
    IF Game.T < Game.WarningUntil THEN
        IF INT(Game.T * 4) MOD 2 = 0 THEN
            Banner 11, "                         ", 15, 4
            Banner 12, "   !!!   WARNING   !!!   ", 15, 4
            Banner 13, "                         ", 15, 4
        END IF
    END IF

    'Freeze / overdrive timers
    IF Ply.Freeze AND Ply.Alive THEN
        n = INT(10 - (Game.T - Ply.FreezeT))
        IF n < 0 THEN n = 0
        IF n > 10 THEN n = 10
        IF n <= 3 THEN COLOR 9 + 16 ELSE COLOR 9
        PutText 2, 3, STRING$(n, 219) + STRING$(10 - n, 220)
        IF n <= 3 THEN COLOR 11 + 16 ELSE COLOR 11
        PutText 2, 4, "TIME FREEZE"
    END IF
    IF Game.T < Ply.OverdriveEnd AND Ply.Alive THEN
        n = INT(Ply.OverdriveEnd - Game.T + .99)
        IF n > 8 THEN n = 8
        COLOR 10
        PutText 2, 5, STRING$(n, 219) + STRING$(8 - n, 220)
        COLOR 2
        PutText 2, 6, "OVERDRIVE"
    END IF

    'Generic message
    IF Game.T < Game.MsgUntil THEN
        Banner 13, " " + RTRIM$(Game.MsgText) + " ", 15, Game.MsgClr
    END IF

    'Death message
    IF Ply.Dying THEN Banner 13, " " + RTRIM$(Ply.DeathMsg) + " ", 15, 4

    IF Game.Paused THEN
        DrawLogo 100, 8 + INT(8 * ABS(SIN(RealNow# * 2)))
        Banner 13, "     PAUSED      ", 15, 1
        COLOR 7, 0
        CenterText 15, "START: RESUME   SELECT/Q: QUIT TO TITLE   M: MUTE"
    END IF
    COLOR , 0
END SUB

'Saves the current frame as PNG (autotest screenshots)
SUB SaveShot (tag AS STRING)
    DIM f AS STRING
    IF LEN(RTRIM$(Test.ShotDir)) = 0 THEN EXIT SUB
    Test.ShotNo = Test.ShotNo + 1
    f = RTRIM$(Test.ShotDir) + Sep + PadNum$(Test.ShotNo, 4) + "_" + tag + ".png"
    _PALETTECOLOR 0, _RGB32(0, 0, 0)
    _SAVEIMAGE f
    _PALETTECOLOR 0, _RGBA32(0, 0, 0, 0)
END SUB
